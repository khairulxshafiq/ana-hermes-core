# ==========================================
# ANA HERMES CORE — ENVIRONMENT TEMPLATE
# ==========================================
# Salin fail ini kepada .env dan masukkan kunci API anda:
#   cp .env.example .env
# ==========================================

# 1. TELEGRAM INTEGRATION
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_HOME_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_HOME_USER_ID=your_telegram_chat_id_here

# 2. LLM PROVIDERS
# Model Lalai: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_PAID=your_gemini_api_key_here
GEMINI_API_KEY_FREE=your_gemini_api_key_here

# Fallback Models (OpenRouter / BytePlus)
OPENROUTER_API_KEY=your_openrouter_api_key_here
BYTEPLUS_API_KEY=your_byteplus_api_key_here

# 3. RUNTIME & SYSTEM
HERMES_HOME=/home/ubuntu/.hermes
DEFAULT_MODEL=gemini-3.8-flash
FALLBACK_MODEL=google/gemini-2.0-flash-exp:free

# 4. OPTIONAL INTEGRATIONS
# Webhook / Supabase / Cloudflare
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=
