[Unit]
Description=TanAir Cross-Cloud FastAPI Bridge (ANA-PA Node)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HERMES_HOME}
Environment="PYTHONPATH=${HERMES_HOME}"
Environment="PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/.local/bin/uvicorn bridge.cross_cloud_bridge:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
